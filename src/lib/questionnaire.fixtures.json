{
  "definition": {
    "key": "fixture_form",
    "version": 1,
    "content_status": "unverified",
    "sections": [
      {
        "key": "basics",
        "title": "Basics",
        "visible_if": null,
        "questions": [
          {
            "key": "kind",
            "type": "single_select",
            "label": "Kind",
            "required": true,
            "visible_if": null,
            "options": [
              {
                "value": "food",
                "label": "Food"
              },
              {
                "value": "tech",
                "label": "Tech"
              },
              {
                "value": "other",
                "label": "Other"
              }
            ]
          },
          {
            "key": "name",
            "type": "text",
            "label": "Name",
            "required": true,
            "max_length": 10,
            "visible_if": null
          },
          {
            "key": "notes",
            "type": "long_text",
            "label": "Notes",
            "required": false,
            "visible_if": null
          },
          {
            "key": "staff",
            "type": "integer",
            "label": "Staff",
            "required": false,
            "min": 0,
            "max": 100,
            "visible_if": null
          },
          {
            "key": "founded",
            "type": "date",
            "label": "Founded",
            "required": false,
            "visible_if": null
          },
          {
            "key": "year_end",
            "type": "month_day",
            "label": "Year end",
            "required": false,
            "visible_if": null
          },
          {
            "key": "regulated",
            "type": "boolean",
            "label": "Regulated",
            "required": true,
            "visible_if": null
          }
        ]
      },
      {
        "key": "food",
        "title": "Food",
        "visible_if": {
          "all": [
            {
              "q": "kind",
              "op": "eq",
              "value": "food"
            }
          ]
        },
        "questions": [
          {
            "key": "products",
            "type": "multi_select",
            "label": "Products",
            "required": true,
            "max_items": 2,
            "visible_if": null,
            "options": [
              {
                "value": "bread",
                "label": "Bread"
              },
              {
                "value": "juice",
                "label": "Juice"
              },
              {
                "value": "rice",
                "label": "Rice"
              }
            ]
          },
          {
            "key": "licence_no",
            "type": "text",
            "label": "Licence number",
            "required": true,
            "visible_if": {
              "any": [
                {
                  "q": "regulated",
                  "op": "is_true"
                },
                {
                  "q": "products",
                  "op": "contains",
                  "value": "juice"
                }
              ]
            }
          }
        ]
      },
      {
        "key": "people",
        "title": "People",
        "visible_if": {
          "all": [
            {
              "q": "kind",
              "op": "neq",
              "value": "other"
            }
          ]
        },
        "questions": [
          {
            "key": "owners",
            "type": "person_list",
            "label": "Owners",
            "required": false,
            "max_items": 2,
            "visible_if": null,
            "fields": [
              {
                "key": "full_name",
                "label": "Full name",
                "type": "text",
                "required": true
              },
              {
                "key": "percent",
                "label": "Percent",
                "type": "number",
                "required": false
              }
            ]
          },
          {
            "key": "owner_note",
            "type": "text",
            "label": "About the owners",
            "required": true,
            "visible_if": {
              "all": [
                {
                  "q": "owners",
                  "op": "answered"
                }
              ]
            }
          }
        ]
      },
      {
        "key": "arrays",
        "title": "Arrays",
        "visible_if": {
          "all": [
            {
              "q": "name",
              "op": "eq",
              "value": "Arrays"
            }
          ]
        },
        "questions": [
          {
            "key": "tags",
            "type": "multi_select",
            "label": "Tags",
            "required": false,
            "visible_if": null,
            "options": [
              {
                "value": "a",
                "label": "A"
              },
              {
                "value": "b",
                "label": "B"
              },
              {
                "value": "c",
                "label": "C"
              }
            ]
          },
          {
            "key": "tags_eq",
            "type": "text",
            "label": "Tags equal a,b",
            "required": false,
            "visible_if": {
              "all": [
                {
                  "q": "tags",
                  "op": "eq",
                  "value": [
                    "a",
                    "b"
                  ]
                }
              ]
            }
          },
          {
            "key": "tags_neq",
            "type": "text",
            "label": "Tags answered and not a,b",
            "required": false,
            "visible_if": {
              "all": [
                {
                  "q": "tags",
                  "op": "answered"
                },
                {
                  "q": "tags",
                  "op": "neq",
                  "value": [
                    "a",
                    "b"
                  ]
                }
              ]
            }
          },
          {
            "key": "tags_in",
            "type": "text",
            "label": "Tags one of [b] or [a,b]",
            "required": false,
            "visible_if": {
              "all": [
                {
                  "q": "tags",
                  "op": "in",
                  "value": [
                    [
                      "b"
                    ],
                    [
                      "a",
                      "b"
                    ]
                  ]
                }
              ]
            }
          },
          {
            "key": "crew",
            "type": "person_list",
            "label": "Crew",
            "required": false,
            "visible_if": null,
            "fields": [
              {
                "key": "full_name",
                "label": "Full name",
                "type": "text",
                "required": true
              },
              {
                "key": "score",
                "label": "Score",
                "type": "number",
                "required": false,
                "min": 5,
                "max": 500
              },
              {
                "key": "ratio",
                "label": "Ratio",
                "type": "number",
                "required": false
              }
            ]
          }
        ]
      }
    ]
  },
  "cases": [
    {
      "name": "empty answers: required visible questions are missing (neq on an unanswered question holds)",
      "answers": {},
      "expected": {
        "visible": [
          "kind",
          "name",
          "notes",
          "staff",
          "founded",
          "year_end",
          "regulated",
          "owners"
        ],
        "missing": [
          "kind",
          "name",
          "regulated"
        ],
        "errors": []
      }
    },
