{
  "name": "companyhousemobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "e2e": "MAESTRO_CLI_NO_ANALYTICS=1 MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true ${MAESTRO:-$HOME/.maestro/bin/maestro} test e2e/",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "8.28.1",
    "@tanstack/react-query": "5.108.4",
    "expo": "58.1.0",
    "expo-application": "58.1.2",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.9",
    "expo-document-picker": "58.0.5",
    "expo-file-system": "58.0.15",
    "expo-font": "58.0.12",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-local-authentication": "58.0.3",
    "expo-router": "58.0.33",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.15",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
