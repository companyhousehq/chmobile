    "@types/node": "26.6.11",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.16",
    "patch-package": "8.0.0",
    "prettier": "3.10.1",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
