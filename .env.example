# Non-secret defaults. Copy to a local file and adjust; never commit real values.
# API base URL. Optional in development (iOS simulator defaults to http://localhost:8080,
# Android emulator to http://10.0.2.2:8080). Required in release builds: the app refuses to start without it.
EXPO_PUBLIC_API_URL=
# Sentry is disabled while this is empty (a DSN is not a secret but is set per environment).
EXPO_PUBLIC_SENTRY_DSN=
